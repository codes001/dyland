[Unit]
Description=dyland Dynamic Island UI
After=graphical-session.target dyd-daemon.service
PartOf=graphical-session.target
Wants=dyd-daemon.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@BINDIR@/dyd-ui
Restart=on-failure
RestartSec=2s
Environment=DYD_LOG=info

[Install]
WantedBy=graphical-session.target
