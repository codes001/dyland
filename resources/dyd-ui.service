[Unit]
Description=dyland Dynamic Island UI
After=graphical-session.target dyd-daemon.service
Wants=graphical-session.target dyd-daemon.service

[Service]
Type=simple
ExecStart=/usr/bin/dyd-ui
# on-failure: crashes/signals restart it, but a clean tray "Quit" stays quit
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
