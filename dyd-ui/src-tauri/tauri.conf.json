{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "dyland",
  "version": "0.1.0",
  "identifier": "app.dyland",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "dyland",
        "width": 400,
        "height": 100,
        "decorations": false,
        "transparent": true,
        "always_on_top": true,
        "focus": false,
        "skip_taskbar": true,
        "resizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
